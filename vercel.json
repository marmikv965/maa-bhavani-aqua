{
  "framework": null,
  "outputDirectory": "public",
  "redirects": [
    { "source": "/admin", "destination": "/admin/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/uploads/:path*", "destination": "/api" },
    { "source": "/admin/login", "destination": "/admin/login.html" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  }
}
